{
  "name": "globeoptimiser",
  "version": "1.0.0",
  "description": "Globe Optimiser - Premium Bulk Image & Video Optimization Engine",
  "private": true,
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/worker.test.mjs && python3 tests/check_static_build.py",
    "dev:backend": "uvicorn backend.main:app --reload --host 127.0.0.1 --port 8000",
    "test:backend": "pytest"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
