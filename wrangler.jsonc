{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globeoptimiser",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": {
    // Native Python media processing stays on the existing backend during migration.
    // Never use globeoptimiser.com here: it points back to this Worker.
    "API_ORIGIN": "https://globeoptimiser.vercel.app"
  },
  "observability": { "enabled": true }
}
